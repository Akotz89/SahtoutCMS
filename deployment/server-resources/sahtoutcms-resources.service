[Unit]
Description=Read-only server resource snapshot for SahtoutCMS
[Service]
Type=oneshot
User=sahtoutcms
Group=sahtoutcms
ExecStart=/usr/bin/python3 /usr/local/libexec/sahtoutcms-resources.py
Nice=15
MemoryMax=64M
TasksMax=8
TimeoutStartSec=20
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/sahtoutcms/metrics
